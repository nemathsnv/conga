# Supabase CLI configuration secrets. SERVER-SIDE ONLY. Copy to supabase/.env (git-ignored).
# Used by `supabase start` (local) and `supabase config push` (hosted) through env() in config.toml.
# Never put any of these in the app.

# Sign in with Apple. developer.apple.com -> Certificates, Identifiers & Profiles.
# Client id: the iOS bundle id (app.shortcut) for native sign-in, plus the Services ID for the
# web flow used on Android, comma separated. Secret: the generated client secret JWT.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=app.shortcut
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Google Sign-In. console.cloud.google.com -> APIs & Services -> Credentials.
# Client id: the iOS client id and the web client id, comma separated. Secret: the web client secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
