# The committed lockfile was resolved with peer dependencies NOT auto-installed.
# expo-router depends on react-native-drawer-layout, whose hard peers (react-native-gesture-handler,
# react-native-reanimated, and through it react-native-worklets) npm would otherwise add: three
# native modules the app does not use and the tested build never contained. See docs/release/BUILD.md.
legacy-peer-deps=true
