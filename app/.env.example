# Conga app configuration. Copy to app/.env and fill in. app/.env is git-ignored.
#
# PUBLIC CLIENT VALUES ONLY. Everything prefixed EXPO_PUBLIC_ is bundled into the app.
# Never put a service-role key, a Supabase personal access token, an Apple secret or a
# Google client secret here. Server secrets live in supabase/.env and Edge Function secrets.

# Supabase project. Dashboard -> Project Settings -> API. For local development use
# http://<your Mac's LAN IP>:54321 and the local anon key printed by `supabase start`.
# For the hosted project use https://<ref>.supabase.co and its PUBLISHABLE key (sb_publishable_...),
# not the legacy anon key and never a secret key or the service-role key (Nemat, 10 Oct 2026).
# If either is empty the app cannot reach a backend; see docs/release/BUILD.md.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of shared links (/r/<id>, /p/<id>, /u/<name>, /i/<code>), no trailing slash:
# https://conga.churntech.com for anything that reaches a phone (eas.json sets it for preview and
# production; scripts/founder-ios.sh release defaults to it). Empty only for local development:
# links then use <SUPABASE_URL>/functions/v1/web.
EXPO_PUBLIC_WEB_BASE_URL=

# Google Sign-In (console.cloud.google.com -> Credentials). Public client ids.
# The web client id is what Supabase verifies; the iOS client id is used by the iOS SDK.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd. Needed at prebuild time.
GOOGLE_IOS_URL_SCHEME=

# Apple Team ID (10 characters) for local iOS code signing. Not a secret.
APPLE_TEAM_ID=

# EAS project id (a UUID) from `eas init` on Nemat's Expo account. Without it the app mints no push
# token, no EAS build runs and builds never ask for over-the-air updates (docs/release/OTA-UPDATES.md).
# Not a secret. Not created yet (docs/BLOCKERS.md B-2, B-4). The founder build reads it from .env.founder.
EAS_PROJECT_ID=

# Android push (FCM): path to the Firebase google-services.json (git-ignored). On EAS it is a file
# environment variable of the same name. Empty = the Android build has no push (docs/release/ANDROID.md).
GOOGLE_SERVICES_JSON=

# Development helpers that are not part of the product (a Sign out control on the Me tab
# and phase labels). Leave empty or 0 for any build a tester could see; eas.json forces 0 for
# the preview and production profiles.
EXPO_PUBLIC_DEV_TOOLS=

# EXPO_PUBLIC_FOUNDER_BUILD=1 is set only by app/scripts/founder-ios.sh from app/.env.founder
# (free Personal Team build for Nemat's own iPhone). Do not set it here.
