# Shortcut app configuration. Copy to app/.env and fill in. app/.env is git-ignored.
#
# PUBLIC CLIENT VALUES ONLY. Everything prefixed EXPO_PUBLIC_ is bundled into the app.
# Never put a service-role key, a Supabase personal access token, an Apple secret or a
# Google client secret here. Server secrets live in supabase/.env and Edge Function secrets.

# Supabase project. Dashboard -> Project Settings -> API. For local development use
# http://<your Mac's LAN IP>:54321 and the local anon key printed by `supabase start`.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (console.cloud.google.com -> Credentials). Public client ids.
# The web client id is what Supabase verifies; the iOS client id is used by the iOS SDK.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd. Needed at prebuild time.
GOOGLE_IOS_URL_SCHEME=

# Apple Team ID (10 characters) for local iOS code signing. Not a secret.
APPLE_TEAM_ID=

# Development helpers that are not part of the product (a Sign out control on the Me tab
# until Settings exists). Leave empty for any build a tester could see.
EXPO_PUBLIC_DEV_TOOLS=
