# Edge Function secrets for the spike. SERVER-SIDE ONLY.
# Copy to spike/supabase/.env (git-ignored) and push with:
#   supabase secrets set --env-file spike/supabase/.env
# This file is never read by the mobile app.

# Mux access token. dashboard.mux.com -> Settings -> Access Tokens -> Generate new token.
# Environment: Development. Permissions: Mux Video, Read and Write.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
