# Shortcut phase 1 video spike: mobile app configuration.
# Copy to spike/.env and fill in. spike/.env is git-ignored.
#
# PUBLIC CLIENT VALUES ONLY. Everything here is bundled into the app.
# Never put a Mux token, a Supabase service-role key or a Supabase personal
# access token in this file. Mux credentials live as Edge Function secrets
# (see spike/supabase/.env.example). CLI deploy auth comes from `supabase login`.

# Supabase dev project. Dashboard -> Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Apple Team ID (10 characters) for local iOS code signing. Not a secret.
# Xcode -> Settings -> Accounts -> your team, or developer.apple.com -> Membership.
APPLE_TEAM_ID=
