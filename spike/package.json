{
  "name": "shortcut-video-spike",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios:dev": "expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release",
    "android:dev": "expo run:android --device",
    "android:release": "expo run:android --device --variant release",
    "typecheck": "tsc --noEmit",
    "summarize": "node scripts/summarize.mjs"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-cellular": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-keep-awake": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
